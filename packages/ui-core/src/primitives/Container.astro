---
interface Props {
  class?: string;
  width?: 'prose' | 'default' | 'wide';
}
const { class: className, width = 'default' } = Astro.props;
const widths = {
  prose: 'max-w-3xl',
  default: 'max-w-6xl',
  wide: 'max-w-7xl',
};
---

<div class:list={['mx-auto w-full px-5 sm:px-8', widths[width], className]}>
  <slot />
</div>
