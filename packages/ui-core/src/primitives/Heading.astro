---
/**
 * Only Hero and PageHeader render level 1. The page schema enforces
 * exactly one of those per page, so every page has exactly one H1.
 */
interface Props {
  level?: 1 | 2 | 3;
  size?: 'display' | 'xl' | 'lg' | 'md';
  id?: string;
  class?: string;
}
const { level = 2, size = 'lg', id, class: className } = Astro.props;
const Tag = `h${level}` as 'h1' | 'h2' | 'h3';
const sizes = {
  display: 'text-display',
  xl: 'text-heading-xl',
  lg: 'text-heading-lg',
  md: 'text-heading-md',
};
---

<Tag id={id} class:list={['font-display text-balance', sizes[size], className]}>
  <slot />
</Tag>
