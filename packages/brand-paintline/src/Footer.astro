---
import type { BrandConfig } from '@platform/ui-core/brand';
import { copyrightLine } from '@platform/ui-core/legal';
import Container from '@platform/ui-core/primitives/Container.astro';
import Logo from './Logo.astro';

interface Props {
  brand: BrandConfig;
}
const { brand } = Astro.props;
// Built as one string so the year, name and sentence can never run together.
const legal = `${copyrightLine(brand.name)} Demo brand: a fictional company for a platform demonstration. No services are sold here.`;
---

<footer class="bg-inverse text-on-inverse mt-8 rounded-t-[2.5rem]" data-tone="inverse">
  <Container width="wide" class="grid gap-10 py-16 md:grid-cols-12">
    <div class="md:col-span-5">
      <Logo />
      <p class="text-ink-muted mt-5 max-w-sm leading-relaxed">{brand.footer.blurb}</p>
      <p class="bg-marigold text-ink mt-6 inline-flex rounded-full px-3.5 py-1.5 text-xs font-bold tracking-wide uppercase" data-demo-brand>
        Demo brand
      </p>
    </div>
    <nav aria-label="Footer" class="md:col-span-3">
      <p class="text-ink-muted text-sm font-bold">Explore</p>
      <ul class="mt-4 space-y-2.5" role="list">
        {
          brand.nav.map((link) => (
            <li>
              <a href={link.href} class="hover:text-marigold transition-colors">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="md:col-span-4">
      <p class="text-ink-muted text-sm font-bold">Studio</p>
      <address class="mt-4 leading-relaxed not-italic">{brand.footer.address}</address>
      <p class="mt-2">
        <a href={`mailto:${brand.footer.email}`} class="hover:text-marigold underline underline-offset-4">{brand.footer.email}</a>
      </p>
    </div>
  </Container>
  <div class="border-line border-t">
    <Container width="wide" class="text-ink-muted flex flex-col gap-3 py-6 text-sm sm:flex-row sm:items-center sm:justify-between">
      <p data-footer-legal>{legal}</p>
      <button type="button" data-consent-open class="hover:text-on-inverse text-left underline underline-offset-4">
        Cookie settings
      </button>
    </Container>
  </div>
</footer>
