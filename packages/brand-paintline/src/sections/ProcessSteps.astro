---
import type { z } from 'astro/zod';
import Container from '@platform/ui-core/primitives/Container.astro';
import Section from '@platform/ui-core/primitives/Section.astro';
import type { processSteps } from '../schemas';
import SectionIntro from './SectionIntro.astro';

type Props = z.infer<typeof processSteps.schema> & { index?: number };
const { id, eyebrow, heading, intro, steps, index = 0 } = Astro.props;
const headingId = `${id ?? `steps-${index}`}-title`;
const colors = ['text-terracotta', 'text-cobalt', 'text-teal', 'text-terracotta', 'text-cobalt', 'text-teal'];
---

<Section id={id} labelledBy={headingId} tone="muted">
  <Container width="wide">
    <SectionIntro eyebrow={eyebrow} heading={heading} intro={intro} headingId={headingId} align="center" class="mx-auto" />
    <ol class="mt-14 grid gap-10 sm:grid-cols-2 lg:auto-cols-fr lg:grid-flow-col lg:grid-cols-none">
      {
        steps.map((step, i) => (
          <li class="border-line-strong border-t pt-6">
            <p class:list={['font-display text-6xl leading-none italic', colors[i]]} aria-hidden="true">
              {i + 1}
            </p>
            <h3 class="font-display mt-4 text-2xl tracking-tight">
              <span class="sr-only">Step {i + 1}: </span>
              {step.title}
            </h3>
            <p class="text-ink-muted mt-2 leading-relaxed">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </Container>
</Section>
