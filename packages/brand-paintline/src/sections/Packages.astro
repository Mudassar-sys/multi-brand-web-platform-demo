---
import type { z } from 'astro/zod';
import Button from '@platform/ui-core/primitives/Button.astro';
import Container from '@platform/ui-core/primitives/Container.astro';
import Icon from '@platform/ui-core/primitives/Icon.astro';
import Section from '@platform/ui-core/primitives/Section.astro';
import type { packages } from '../schemas';
import SectionIntro from './SectionIntro.astro';

type Props = z.infer<typeof packages.schema> & { index?: number };
const { id, eyebrow, heading, intro, tiers, footnote, index = 0 } = Astro.props;
const headingId = `${id ?? `packages-${index}`}-title`;
---

<Section id={id} labelledBy={headingId} tone="muted">
  <Container width="wide">
    <SectionIntro eyebrow={eyebrow} heading={heading} intro={intro} headingId={headingId} align="center" class="mx-auto" />
    <ul
      class:list={[
        'mx-auto mt-12 grid gap-6',
        tiers.length === 1 ? 'max-w-md' : tiers.length === 2 ? 'max-w-3xl sm:grid-cols-2' : 'lg:grid-cols-3',
      ]}
      role="list"
    >
      {
        tiers.map((tier) => (
          <li
            class:list={[
              'rounded-card flex flex-col p-8',
              tier.highlighted ? 'bg-inverse text-on-inverse shadow-2xl' : 'bg-surface-raised border-line border',
            ]}
            data-tone={tier.highlighted ? 'inverse' : undefined}
          >
            <div class="flex items-center justify-between gap-3">
              <h3 class="font-display text-2xl tracking-tight">{tier.name}</h3>
              {tier.highlighted && (
                <span class="bg-marigold text-ink rounded-full px-3 py-1 text-xs font-bold">Most asked for</span>
              )}
            </div>
            <p class="font-display mt-4 text-4xl tracking-tight">{tier.price}</p>
            <p class="text-ink-muted mt-3 leading-relaxed">{tier.summary}</p>
            <ul class="mt-6 flex-1 space-y-3" role="list">
              {tier.includes.map((item) => (
                <li class="flex gap-2.5">
                  <Icon name="check" class="text-accent-ink mt-0.5 size-5 shrink-0" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            {tier.cta && (
              <Button href={tier.cta.href} class="mt-8 w-full" variant={tier.highlighted ? 'primary' : 'secondary'}>
                {tier.cta.label}
              </Button>
            )}
          </li>
        ))
      }
    </ul>
    <p class="text-ink-muted mx-auto mt-8 max-w-2xl text-center text-sm">{footnote}</p>
  </Container>
</Section>
