---
import type { z } from 'astro/zod';
import Container from '@platform/ui-core/primitives/Container.astro';
import Section from '@platform/ui-core/primitives/Section.astro';
import MuralArt from '../art/MuralArt.astro';
import type { gallery } from '../schemas';
import SectionIntro from './SectionIntro.astro';

type Props = z.infer<typeof gallery.schema> & { index?: number };
const { id, eyebrow, heading, intro, items, note, index = 0 } = Astro.props;
const headingId = `${id ?? `gallery-${index}`}-title`;
---

<Section id={id} labelledBy={headingId}>
  <Container width="wide">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <SectionIntro eyebrow={eyebrow} heading={heading} intro={intro} headingId={headingId} />
      <p class="text-ink-muted border-line-strong max-w-xs rounded-2xl border border-dashed px-4 py-3 text-sm">{note}</p>
    </div>
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {
        items.map((item, i) => (
          <li class:list={['group', i % 3 === 1 && 'lg:translate-y-10']}>
            <figure>
              <div class="rounded-card aspect-[4/3] overflow-hidden transition-transform duration-500 group-hover:scale-[1.015]">
                <MuralArt variant={item.art} />
              </div>
              <figcaption class="mt-4 flex items-start justify-between gap-4">
                <span>
                  <span class="font-display block text-xl tracking-tight">{item.title}</span>
                  <span class="text-ink-muted mt-1 block text-sm leading-relaxed">{item.caption}</span>
                </span>
                <span class="bg-surface-muted shrink-0 rounded-full px-3 py-1 text-xs font-semibold">{item.space}</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </Container>
</Section>
