    <circle cx="18" cy="18" r="18" fill="#e0573a"></circle>
    <path d="M4 22 C 10 14, 18 26, 26 16 S 34 14, 36 16 V36 H0 V26 Z" fill="#2b45c8"></path>
    <circle cx="24" cy="11" r="5" fill="#f2b33d"></circle>
