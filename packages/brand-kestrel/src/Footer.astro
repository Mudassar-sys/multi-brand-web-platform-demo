---
import type { BrandConfig } from '@platform/ui-core/brand';
import { copyrightLine } from '@platform/ui-core/legal';
import Container from '@platform/ui-core/primitives/Container.astro';
import Logo from './Logo.astro';

interface Props {
  brand: BrandConfig;
}
const { brand } = Astro.props;
// Built as one string so the year, name and sentence can never run together.
const legal = `${copyrightLine(brand.name)} Demo brand: a fictional company for a platform demonstration. Nothing on this site is for sale.`;
---

<footer class="bg-inverse text-on-inverse" data-tone="inverse">
  <Container width="wide" class="grid gap-10 py-14 md:grid-cols-12">
    <div class="md:col-span-5">
      <Logo />
      <p class="text-ink-muted mt-5 max-w-sm leading-relaxed">{brand.footer.blurb}</p>
      <p
        class="border-accent text-accent mt-6 inline-flex items-center gap-2 border px-3 py-1.5 font-mono text-[0.7rem] font-semibold tracking-[0.14em] uppercase"
        data-demo-brand
      >
        Demo brand
      </p>
    </div>
    <nav aria-label="Footer" class="md:col-span-3">
      <p class="text-ink-muted font-mono text-[0.7rem] tracking-[0.14em] uppercase">Pages</p>
      <ul class="mt-4 space-y-2.5" role="list">
        {
          brand.nav.map((link) => (
            <li>
              <a href={link.href} class="hover:text-accent transition-colors">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="md:col-span-4">
      <p class="text-ink-muted font-mono text-[0.7rem] tracking-[0.14em] uppercase">Showroom</p>
      <address class="mt-4 leading-relaxed not-italic">{brand.footer.address}</address>
      <p class="mt-2">
        <a href={`mailto:${brand.footer.email}`} class="hover:text-accent underline underline-offset-4">{brand.footer.email}</a>
      </p>
    </div>
  </Container>
  <div class="border-line border-t">
    <Container width="wide" class="text-ink-muted flex flex-col gap-3 py-6 text-sm sm:flex-row sm:items-center sm:justify-between">
      <p data-footer-legal>{legal}</p>
      <button type="button" data-consent-open class="hover:text-on-inverse text-left underline underline-offset-4">
        Cookie settings
      </button>
    </Container>
  </div>
</footer>
