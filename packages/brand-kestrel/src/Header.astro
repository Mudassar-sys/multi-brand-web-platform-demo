---
import type { BrandConfig } from '@platform/ui-core/brand';
import Button from '@platform/ui-core/primitives/Button.astro';
import Container from '@platform/ui-core/primitives/Container.astro';
import Logo from './Logo.astro';

interface Props {
  brand: BrandConfig;
  minimal?: boolean;
}
const { brand, minimal = false } = Astro.props;
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header class="border-line bg-surface/90 sticky top-0 z-30 border-b backdrop-blur-md">
  <Container width="wide" class="flex h-16 items-center justify-between gap-6">
    <a href="/" class="focus-visible:outline-focus rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4">
      <Logo />
      <span class="sr-only">{brand.name} home</span>
    </a>
    {
      !minimal && (
        <nav aria-label="Main" class="hidden md:block">
          <ul class="flex items-center gap-8" role="list">
            {brand.nav.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isCurrent(link.href) ? 'page' : undefined}
                  class="text-ink-muted hover:text-ink aria-[current=page]:text-ink focus-visible:outline-focus relative py-1 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 aria-[current=page]:after:bg-accent aria-[current=page]:after:absolute aria-[current=page]:after:inset-x-0 aria-[current=page]:after:-bottom-[1.3rem] aria-[current=page]:after:h-0.5"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <div class="flex items-center gap-2">
      <Button href={brand.headerCta.href} class="hidden sm:inline-flex">{brand.headerCta.label}</Button>
      {
        !minimal && (
          <details class="group relative md:hidden">
            <summary class="border-line-strong focus-visible:outline-focus flex size-11 cursor-pointer list-none items-center justify-center border focus-visible:outline-2 [&::-webkit-details-marker]:hidden">
              <span class="sr-only">Menu</span>
              <span class="flex w-5 flex-col gap-1.5" aria-hidden="true">
                <span class="bg-ink h-0.5 w-full transition-transform group-open:translate-y-1 group-open:rotate-45" />
                <span class="bg-ink h-0.5 w-full transition-transform group-open:-translate-y-1 group-open:-rotate-45" />
              </span>
            </summary>
            <nav aria-label="Mobile" class="border-line-strong bg-surface-raised absolute top-13 right-0 w-64 border p-2 shadow-xl">
              <ul role="list">
                {brand.nav.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      aria-current={isCurrent(link.href) ? 'page' : undefined}
                      class="hover:bg-surface-muted aria-[current=page]:text-accent-ink block px-3 py-3 font-medium"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
                <li class="p-1 pt-2">
                  <Button href={brand.headerCta.href} class="w-full">{brand.headerCta.label}</Button>
                </li>
              </ul>
            </nav>
          </details>
        )
      }
    </div>
  </Container>
</header>
