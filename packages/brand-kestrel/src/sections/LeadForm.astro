---
import type { z } from 'astro/zod';
import LeadFormShell from '@platform/forms/LeadFormShell.astro';
import Button from '@platform/ui-core/primitives/Button.astro';
import Container from '@platform/ui-core/primitives/Container.astro';
import Icon from '@platform/ui-core/primitives/Icon.astro';
import Section from '@platform/ui-core/primitives/Section.astro';
import type { leadForm } from '../schemas';
import Field from './Field.astro';
import SectionIntro from './SectionIntro.astro';

type Props = z.infer<typeof leadForm.schema> & { index?: number };
const {
  id = 'form',
  eyebrow,
  heading,
  intro,
  formId,
  fields = [],
  interestLabel = 'What are you interested in?',
  interestOptions = [],
  submitLabel = 'Send',
  successMessage,
  points = [],
} = Astro.props;
const headingId = `${id}-title`;
const has = (name: (typeof fields)[number]) => fields.includes(name);
---

<Section id={id} labelledBy={headingId} tone="muted">
  <Container width="wide" class="grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <SectionIntro eyebrow={eyebrow} heading={heading} intro={intro} headingId={headingId} />
      {
        points.length > 0 && (
          <ul class="mt-8 space-y-4" role="list">
            {points.map((point) => (
              <li class="flex gap-3">
                <span class="bg-accent text-on-accent mt-0.5 inline-flex size-5 shrink-0 items-center justify-center">
                  <Icon name="check" class="size-3.5" />
                </span>
                <span class="leading-relaxed">{point}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <div class="lg:col-span-7">
      <div class="border-line-strong bg-surface-raised border p-6 shadow-[0_24px_48px_-32px_rgb(15_19_24/0.4)] sm:p-8">
        <LeadFormShell formId={formId} successMessage={successMessage} class="grid gap-5 sm:grid-cols-2">
          <Field formId={formId} name="first_name" label="First name" required autocomplete="given-name" maxlength={60} />
          {has('lastName') && <Field formId={formId} name="last_name" label="Last name" autocomplete="family-name" maxlength={60} />}
          <Field formId={formId} name="email" label="Work email" type="email" required autocomplete="email" class="sm:col-span-2" />
          {has('phone') && <Field formId={formId} name="phone" label="Phone" type="tel" autocomplete="tel" maxlength={30} />}
          {has('company') && <Field formId={formId} name="company" label="Shop or company" autocomplete="organization" />}
          {has('city') && <Field formId={formId} name="city" label="City and state" autocomplete="address-level2" maxlength={80} />}
          {
            has('interest') && (
              <Field formId={formId} name="interest" label={interestLabel} type="select" options={interestOptions} class="sm:col-span-2" />
            )
          }
          {has('message') && <Field formId={formId} name="message" label="What do you turn today?" type="textarea" class="sm:col-span-2" />}
          <div class="flex flex-col gap-4 sm:col-span-2 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-ink-muted text-xs leading-relaxed">
              Demo form. Submissions run in dry-run mode and are not stored by any provider.
            </p>
            <Button type="submit" size="lg" icon="arrow-right" data-submit>{submitLabel}</Button>
          </div>
        </LeadFormShell>
      </div>
    </div>
  </Container>
</Section>
